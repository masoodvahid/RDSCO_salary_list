APP_NAME=RDSCO-Salary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tukahr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=tukahr-login
KAVENEGAR_APPROVAL_TEMPLATE=tukahr-approval
# Optional: a dedicated Kavenegar line. When set, invite links are also sent by SMS.
KAVENEGAR_SENDER=
KAVENEGAR_LOW_CREDIT_THRESHOLD=100000
KAVENEGAR_TIMEOUT_SECONDS=8
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Local/test demo data (manager + sample users + one sheet) created by php artisan db:seed.
# Ignored in production. Without KAVENEGAR_API_KEY, local OTP codes are written to the log.
TUKA_TEST_ADMIN_ENABLED=true

# Optional first manager (created by php artisan db:seed). Login is by SMS code only.
TUKA_ADMIN_NAME=
TUKA_ADMIN_MOBILE=
TUKA_ADMIN_PASSWORD=

# Optional: the name shown in the header, page titles and SMS texts.
# TUKA_APP_NAME="سامانه مدیریت لیست حقوق"

# Pages and grid updates are gzipped by the app when the web server does not. Set false only if the
# host breaks compressed responses.
# TUKA_GZIP=true

# In-app updates (page «به‌روزرسانی»). The token is optional for a public repository.
TUKA_UPDATE_REPO=masoodvahid/RDSCO_salary_list
TUKA_UPDATE_TOKEN=
